# ==============================================================================
# Replyf — Environment Configuration Template
# ==============================================================================
# All variables in this file are OPTIONAL.
# Replyf is architected as a local-first application: if Supabase configuration
# is omitted, the application runs entirely offline using IndexedDB storage.
# ==============================================================================

# Supabase Authentication & Remote Persistence (Optional)
# Set these to enable remote user accounts, cloud backups, and cross-device sync.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Side Supabase Client (Optional)
# Only required if executing server-side administrative jobs or edge functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Development & E2E Testing Flags (Optional)
# Set to 'true' to expose deterministic test hooks and simulation flags in development.
NEXT_PUBLIC_ENABLE_TEST_HELPERS=false
